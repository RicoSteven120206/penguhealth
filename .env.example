# Salin file ini menjadi .env.local lalu isi nilainya.

# Koneksi MongoDB (MongoDB Atlas atau lokal)
MONGODB_URI=mongodb://127.0.0.1:27017/penguhealth

# Kunci rahasia untuk token sesi (minimal 32 karakter acak)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kontak layanan konseling kampus yang ditampilkan pada kartu rujukan
NEXT_PUBLIC_KONSELING_NAMA="Layanan Konseling Kampus"
NEXT_PUBLIC_KONSELING_KONTAK="konseling@kampus.ac.id"
NEXT_PUBLIC_KONSELING_JADWAL="Senin–Jumat, 08.00–16.00 WIB"
